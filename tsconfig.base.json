{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "strictNullChecks": true,
    "esModuleInterop": true,
    "typeRoots": ["node_modules/@types", "packages/types/src/global"],
    "paths": {
      "@zekuru-v2/cache": ["packages/cache/src/index.ts"],
      "@zekuru-v2/core": ["packages/core/src/index.ts"],
      "@zekuru-v2/db": ["packages/db/src/index.ts"],
      "@zekuru-v2/entities": ["packages/entities/src/index.ts"],
      "@zekuru-v2/mocks/cache": ["packages/test/src/mocks/cache"],
      "@zekuru-v2/mocks/utils": ["packages/test/src/mocks/utils"],
      "@zekuru-v2/repositories": ["packages/repositories/src/index.ts"],
      "@zekuru-v2/test": ["packages/test/src/index.ts"],
      "@zekuru-v2/test/pino-disable": [
        "packages/test/src/pino-disable/index.ts"
      ],
      "@zekuru-v2/types": ["packages/types/src/index.ts"],
      "@zekuru-v2/utils": ["packages/utils/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
